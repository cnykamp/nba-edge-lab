    "training_home_win_frequency",
    "fixed_elo_with_60_point_home_advantage",
    "training_mean_home_margin"
  ],
  "metrics": [
    "log_loss",
    "brier",
    "accuracy",
    "calibration_buckets",
    "margin_mae",
    "margin_rmse"
  ],
